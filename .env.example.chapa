# Chapa Payment Integration Configuration
# Get your Chapa credentials from https://chapa.co/dashboard

# Chapa API Keys
# Get these from Chapa Dashboard > Settings > API Keys
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_PUBLIC_KEY=your_chapa_public_key_here

# Chapa API Base URL (typically this - do not change unless instructed)
CHAPA_BASE_URL=https://api.chapa.co/v1

# Application URLs for Chapa Callbacks
# BASE_URL: Your application's base URL
BASE_URL=http://localhost:3000

# CALLBACK_URL: URL where Chapa will send webhook notifications
# This must be publicly accessible for production
CALLBACK_URL=http://localhost:3000/api/payments/chapa/webhook

# RETURN_URL: URL where users are redirected after payment
# Chapa will append ?tx_ref=<transaction_ref> to this URL
RETURN_URL=http://localhost:3000/payment-result

# Email Configuration (for payment notifications)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/myclothefullstack

# Firebase Configuration (if using Firebase)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Application Environment
NODE_ENV=development
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=300
FIREBASE_SESSION_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_MAX=20

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Optional: Telebirr Configuration (if still using)
TELEBIRR_BASE_URL=https://telebirrappcube.ethiomobilemoney.et:38443/apiaccess/payment/gateway
FABRIC_APP_ID=your_fabric_app_id
APP_SECRET=your_app_secret
MERCHANT_APP_ID=your_merchant_app_id
MERCH_CODE=101011
PRIVATE_KEY=your_private_key

# Optional: Exchange Rate API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Port Configuration
PORT=3000

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# File Upload Configuration
MAX_UPLOAD_SIZE=52428800
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=your_session_secret
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Render/Production Deployment
RENDER_GIT_COMMIT=
COMMIT_SHA=
