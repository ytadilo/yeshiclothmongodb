# Chapa Payment Configuration
# Copy relevant variables into cloth_backend/.env
# Get API keys from https://chapa.co/dashboard → Settings → API Keys

# ── Chapa Keys ──────────────────────────────────────────────
CHAPA_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
CHAPA_BASE_URL=https://api.chapa.co/v1

# ── URLs (production) ───────────────────────────────────────
# Render backend
BASE_URL=https://myclothe.app.aletcloud.com

# Chapa will POST payment events here (must be publicly accessible)
CALLBACK_URL=https://myclothe.app.aletcloud.com/api/payments/chapa/webhook

# Chapa redirects the user here after payment (frontend)
RETURN_URL=https://www.yeshiclothe.com.et/payment-result

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=https://www.yeshiclothe.com.et,https://yeshiclothe.com.et

# ── Local development overrides ─────────────────────────────
# Uncomment and use ngrok URL for local webhook testing
# BASE_URL=http://localhost:5000
# CALLBACK_URL=https://<ngrok-id>.ngrok.io/api/payments/chapa/webhook
# RETURN_URL=http://localhost:5000/payment-result
# NODE_ENV=development
