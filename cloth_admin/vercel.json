{
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",                     "destination": "/login.html" },
    { "source": "/login",                "destination": "/login.html" },
    { "source": "/admin/dashboard",      "destination": "/admin/dashboard.html" },
    { "source": "/admin/orders",         "destination": "/admin/orders.html" },
    { "source": "/admin/posts",          "destination": "/admin/posts.html" },
    { "source": "/admin/users",          "destination": "/admin/users.html" },
    { "source": "/admin/chat",           "destination": "/admin/chat.html" },
    { "source": "/admin/order-stats",    "destination": "/admin/order-stats.html" },
    { "source": "/admin/links",          "destination": "/admin/links.html" },
    { "source": "/admin/login",          "destination": "/admin/login.html" },
    { "source": "/admin/forgot-password","destination": "/admin/forgot-password.html" },
    { "source": "/admin/reset-password", "destination": "/admin/reset-password.html" },
    { "source": "/admin/verify-otp",     "destination": "/admin/verify-otp.html" }
  ]
}
