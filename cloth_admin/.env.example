# ──────────────────────────────────────────────
# ADMIN PANEL — Environment Variables
#
# This is a static HTML app. These variables are NOT injected
# at runtime. They are documented here for reference only.
#
# The Firebase config is served dynamically by the backend at
# GET /api/auth/firebase/config — which reads the FIREBASE_WEB_*
# variables set on the backend server.
#
# The only thing to configure here is the backend API URL,
# which is hardcoded in cloth_admin/public/js/admin-config.js
# as the BACKEND variable.
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# BACKEND API URL
# Set this in cloth_admin/public/js/admin-config.js → var BACKEND = '...'
# ──────────────────────────────────────────────
VITE_API_URL=https://myclothe.app.aletcloud.com

# ──────────────────────────────────────────────
# FIREBASE WEB CONFIG (set these on the BACKEND server, not here)
# The backend reads these and returns them via /api/auth/firebase/config
# ──────────────────────────────────────────────
# FIREBASE_WEB_API_KEY=AIzaSy...
# FIREBASE_WEB_AUTH_DOMAIN=yourproject.firebaseapp.com
# FIREBASE_WEB_PROJECT_ID=yourproject
# FIREBASE_WEB_STORAGE_BUCKET=yourproject.firebasestorage.app
# FIREBASE_WEB_MESSAGING_SENDER_ID=123456789
# FIREBASE_WEB_APP_ID=1:123456789:web:abc123

# ──────────────────────────────────────────────
# CORS (set on the BACKEND server)
# Must include the admin domain so API calls are not blocked
# ──────────────────────────────────────────────
# CORS_ORIGINS=https://www.yeshiclothe.com.et,https://yeshiclothe.com.et,https://yeshiclothe.app.aletcloud.com
