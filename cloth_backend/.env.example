# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
# MongoDB Atlas connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ──────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@yeshiclothe.com.et
ADMIN_PASSWORD=replace_with_secure_admin_password

# Google Sign-In — Google Console OAuth 2.0 Client ID
# Used to validate the audience (aud) of Google ID tokens
GOOGLE_CLIENT_ID=

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ──────────────────────────────────────────────
# APP URLS
# ──────────────────────────────────────────────
BASE_URL=https://myclothe.app.aletcloud.com
FRONTEND_URL=https://www.yeshiclothe.com.et

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=https://www.yeshiclothe.com.et,https://yeshiclothe.com.et,https://yeshiclothe.app.aletcloud.com

# ──────────────────────────────────────────────
# CHAPA PAYMENT
# Get keys from https://chapa.co/dashboard → Settings → API Keys
# ──────────────────────────────────────────────
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
CALLBACK_URL=https://myclothe.app.aletcloud.com/api/payments/chapa/webhook
RETURN_URL=https://www.yeshiclothe.com.et/payment-result

# ──────────────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────
# RATE LIMITING & UPLOADS
# ──────────────────────────────────────────────
RATE_LIMIT_MAX=300
MAX_UPLOAD_SIZE=52428800

# ──────────────────────────────────────────────
# OPTIONAL EXTRAS
# ──────────────────────────────────────────────
LOG_LEVEL=info
UPLOAD_PATH=./uploads
EXCHANGE_RATE_API_KEY=

# Afromessage SMS service
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_SENDER=
ADMIN_PHONE=+251933797981

# Render / aletcloud deployment metadata (auto-set by platform)
RENDER_GIT_COMMIT=
COMMIT_SHA=
