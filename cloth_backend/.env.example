# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
# "mongo" or "firebase"
DB_PROVIDER=firebase

# MongoDB (used when DB_PROVIDER=mongo)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/myclothefullstack

# Firebase (used when DB_PROVIDER=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: paste the whole service-account JSON here
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# ──────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@yeshiclothe.com.et

# ──────────────────────────────────────────────
# APP URLS
# ──────────────────────────────────────────────
# Backend (Render)
BASE_URL=https://myclothefullstackhaile.onrender.com
# Frontend (Vercel / custom domain)
FRONTEND_URL=https://www.yeshiclothe.com.et

# ──────────────────────────────────────────────
# CHAPA PAYMENT
# Get keys from https://chapa.co/dashboard → Settings → API Keys
# ──────────────────────────────────────────────
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Chapa will POST payment events to CALLBACK_URL (must be public)
CALLBACK_URL=https://myclothefullstackhaile.onrender.com/api/payments/chapa/webhook

# Chapa redirects the user to RETURN_URL after payment
RETURN_URL=https://www.yeshiclothe.com.et/payment-result

# ──────────────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=https://www.yeshiclothe.com.et,https://yeshiclothe.com.et

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_MAX=300
FIREBASE_SESSION_RATE_LIMIT_MAX=12
AUTH_RATE_LIMIT_MAX=20

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ──────────────────────────────────────────────
# FILE UPLOADS
# ──────────────────────────────────────────────
MAX_UPLOAD_SIZE=52428800
UPLOAD_PATH=./uploads

# ──────────────────────────────────────────────
# OPTIONAL EXTRAS
# ──────────────────────────────────────────────
# Exchange rate API
EXCHANGE_RATE_API_KEY=

# Render deployment metadata (auto-set by Render)
RENDER_GIT_COMMIT=
COMMIT_SHA=
