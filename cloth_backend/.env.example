# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
# "mongo" (default) or "firebase"
DB_PROVIDER=mongo

# MongoDB Atlas connection string (required when DB_PROVIDER=mongo)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Firebase Admin SDK credentials (used for Firebase Auth verification only — not Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: paste the whole service-account JSON here
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Firebase Web SDK config — returned to the browser via GET /api/auth/firebase/config
# Get these from Firebase Console → Project Settings → Your apps → Web app → SDK setup
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MEASUREMENT_ID=

# ──────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_secret_at_least_32_chars
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@yeshiclothe.com.et
ADMIN_PASSWORD=replace_with_secure_admin_password

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ──────────────────────────────────────────────
# APP URLS
# ──────────────────────────────────────────────
# Backend base URL
BASE_URL=https://myclothe.app.aletcloud.com
# Frontend URL
FRONTEND_URL=https://www.yeshiclothe.com.et

# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=https://www.yeshiclothe.com.et,https://yeshiclothe.com.et,https://yeshiclothe.app.aletcloud.com

# ──────────────────────────────────────────────
# CHAPA PAYMENT
# Get keys from https://chapa.co/dashboard → Settings → API Keys
# ──────────────────────────────────────────────
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Chapa will POST payment events to CALLBACK_URL (must be publicly reachable)
CALLBACK_URL=https://myclothe.app.aletcloud.com/api/payments/chapa/webhook

# Chapa redirects the user to RETURN_URL after payment
RETURN_URL=https://www.yeshiclothe.com.et/payment-result

# ──────────────────────────────────────────────
# EMAIL (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
RATE_LIMIT_MAX=300

# ──────────────────────────────────────────────
# FILE UPLOADS
# ──────────────────────────────────────────────
MAX_UPLOAD_SIZE=52428800

# ──────────────────────────────────────────────
# OPTIONAL EXTRAS
# ──────────────────────────────────────────────
LOG_LEVEL=info
UPLOAD_PATH=./uploads

# Exchange rate API
EXCHANGE_RATE_API_KEY=

# Afromessage SMS service
# Get token, identifier, and verified sender from https://afromessage.com
AFROMESSAGE_API_TOKEN=
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_SENDER=
ADMIN_PHONE=+251933797981

# aletcloud / Render deployment metadata (auto-set if configured)
RENDER_GIT_COMMIT=
COMMIT_SHA=
